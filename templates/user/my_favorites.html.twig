{% extends 'base.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}
    <div class="container">
        <h1>Mes favoris</h1>
        <table class="table table-bordered">
            <tr>
                <th>Image</th>
                <th>Produit</th>
                <th>Prix</th>
                <th>Action</th>
            </tr>
            {% for product in products %}
            {# {{ dump(item) }} #} {#pour savoir ou se trouve mes informations dans mon tableau pour l'annotation pointé#}
                <tr>
                    <td style="width:110px;"><img style="width:100px;" src="{{asset('uploads/images/'~product.image)}}"</td>
                    <td>{{product.name}}</td>
                    {# <td>{{product.image}}</td> #}
                    <td>{{product.price}}€</td>
                    <td>
                        <a href="{{ path('app_product_favorites', {'id': product.id}) }}" class="text-danger text-decoration-none">Supprimer des favoris</a>
                    </td>
                </tr>
            {% else %}
                <p>Votre panier est vide</p>
            {% endfor %}
        </table>
        {# {% if total > 0 %}
            <h2>Total : {{total}}€</h2>
            <div class="row">
                <a data-turbo="false" class= "btn btn-outline-primary w-25"href="{{path ('app_order')}}">Valider la commande</a>
                <a class= "btn btn-outline-danger w-25"href="{{ path('app_cart_remove') }}">Vider le panier</a>
            </div>
        {% endif %} #}
    
    </div>
{% endblock %}